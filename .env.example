# --- Supabase (Settings → API en el dashboard del proyecto) ---
# Si no se configuran, la app funciona igual usando localStorage.
VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_ANON_KEY="TU_ANON_KEY"

# --- PIN de acceso a la app (pantalla inicial) ---
VITE_APP_PIN="1911"
